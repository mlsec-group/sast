Bootstrap: docker
From: debian:bookworm

%files
	execute.sh /usr/local/bin/execute.sh

%post
	export DEBIAN_FRONTEND=noninteractive
	apt-get update
	apt-get install -y git vim build-essential python3 libpcre3-dev
	git clone https://github.com/danmar/cppcheck.git /cppcheck
	cd /cppcheck && git checkout f4cfed674c20e6991e3726b7e275cf96fc965b29 && \
		make install MATCHCOMPILER=yes FILESDIR=/usr/share/cppcheck HAVE_RULES=yes \
		CXXFLAGS="-O2 -DNDEBUG -Wall -Wno-sign-compare -Wno-unused-function"
	chmod +x /usr/local/bin/execute.sh

%environment
	export CPPCHECK_COMMIT=f4cfed674c20e6991e3726b7e275cf96fc965b29

%runscript
	exec /usr/local/bin/execute.sh "$@"
